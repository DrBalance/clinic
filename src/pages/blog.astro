---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getBlogPosts, fmtDate } from '../lib/naver';

const posts = await getBlogPosts(site.naverBlogId, 30);
const blogUrl = `https://blog.naver.com/${site.naverBlogId}`;
---

<Base title="블로그" description="아침나라한의원 원장이 네이버 블로그에 쓰는 글">
  <article class="doc blog">
    <header class="doc-head">
      <h1>블로그</h1>
      <p class="lede">원장이 네이버 블로그에 쓴 글입니다. 글을 누르면 블로그로 이동합니다.</p>
    </header>

    {
      posts && posts.length > 0 ? (
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={p.link} target="_blank" rel="noopener noreferrer">
                {p.thumb && <img src={p.thumb} alt="" loading="lazy" width="160" height="160" referrerpolicy="no-referrer" />}
                <div class="p-body">
                  <h2>{p.title}</h2>
                  {p.summary && <p>{p.summary}</p>}
                  {p.date && <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">지금은 글 목록을 불러오지 못했습니다. 아래 버튼으로 블로그에서 바로 보실 수 있습니다.</p>
      )
    }

    <p class="to-blog"><a href={blogUrl} target="_blank" rel="noopener noreferrer">네이버 블로그에서 전체 글 보기 →</a></p>
  </article>
</Base>
