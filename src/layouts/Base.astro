---
import '../styles/global.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import FontSizer from '../components/FontSizer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  sizer?: boolean;
  // 이 페이지에 붙일 구조화 데이터(JSON-LD). 한의원 정보는 홈·오시는 길에서 넣습니다.
  jsonLd?: (object | null)[];
}
const { title, description = site.summary, sizer = false, jsonLd = [] } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | 논현동 한의원`;
const path = Astro.url.pathname;
// 같은 페이지가 여러 주소로 잡히지 않도록 대표 주소를 알려줍니다.
const canonical = new URL(path, site.url).toString();
const ogImage = new URL('/og.png', site.url).toString();
const ldList = jsonLd.filter(Boolean);
const nav = [
  { href: '/#treatments', label: '진료 안내' },
  { href: '/herb/', label: '한약' },
  { href: '/intro/', label: '한의원 소개' },
  { href: '/blog/', label: '블로그' },
  { href: '/directions/', label: '오시는 길' },
  { href: '/faq/', label: '자주 묻는 질문' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {site.naverSiteVerification && <meta name="naver-site-verification" content={site.naverSiteVerification} />}
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FBF7F0" />
    {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <!-- 저장된 글씨 크기를 화면이 그려지기 전에 적용 (깜빡임 방지) -->
    <script is:inline>
      try {
        var fs = localStorage.getItem('fs');
        if (fs) document.documentElement.style.setProperty('--fs', fs + 'px');
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- 선이 살짝 흔들려 보이는 손그림 효과 -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="wobble" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2" />
      </filter>
    </svg>

    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-label={`${site.name} 홈`}>
          <img src="/brand/name.svg" alt={site.name} width="169" height="30" />
        </a>
        <nav class="nav" aria-label="주요 메뉴">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="bar-right">
          {sizer && <FontSizer />}
          {
            site.phone ? (
              <a class="tel" href={`tel:${site.phone.replace(/[^0-9]/g, '')}`}>
                <span aria-hidden="true">☎</span> {site.phone}
              </a>
            ) : (
              <span class="tel tel-todo">전화번호 준비 중</span>
            )
          }
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="foot">
        <p class="foot-brand"><img src="/brand/name.svg" alt={site.name} width="135" height="24" /></p>
        <p>{site.address} · {site.station}</p>
        <p class="copy">&copy; {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
  </body>
</html>
